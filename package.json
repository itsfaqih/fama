{
  "name": "personal-branding-template",
  "version": "0.1.0",
  "private": true,
  "portless": "fama",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "cn": "^0.2.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "scripts": {
    "setup": "vp install && vp exec playwright install chromium",
    "dev": "portless run vp dev",
    "start": "portless run vp dev",
    "build": "vp build",
    "preview": "vp preview --port 0",
    "perf": "node tools/perf/measure.ts",
    "font": "node tools/fonts/subset.ts",
    "test": "vp test run --project unit",
    "test:components": "vp test run --project components",
    "test:site": "vp build && vp test run --project site",
    "lint": "vp run lint:ts && vp run lint:format && vp run lint:workflow",
    "lint:fix": "vp run lint:ts:fix && vp run lint:format:fix",
    "lint:ts": "vp lint --deny-warnings . && tsc --noEmit",
    "lint:ts:fix": "vp lint --fix .",
    "lint:format": "vp fmt --check",
    "lint:format:fix": "vp fmt",
    "lint:workflow": "docker run --rm -v \"$PWD\":/repo -w /repo rhysd/actionlint:1.7.12 -color"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.89.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "5.0.5",
    "lighthouse": "^13.6.0",
    "motion": "^13.5.1",
    "playwright": "1.64.1",
    "portless": "0.15.12",
    "react-grab": "^0.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "5.0.5",
    "vitest-browser-react": "2.3.0"
  }
}
